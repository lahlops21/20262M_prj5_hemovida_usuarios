# Copie este arquivo para .env (ou use o Infisical). O .env NUNCA vai para o Git.

DATABASE_URL="mysql://USUARIO:SENHA@edumysql.acesso.rj.senac.br:3306/20262M_prj5_hemovida_usuarios"

# Minimo de 32 caracteres. Tem que ser o MESMO valor nos tres microsservicos
# (quem assina e o MS4; MS1 e MS3 so conferem a assinatura). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

JWT_EXPIRES_IN=1h
PORT=7503

# Primeiro ADMIN, criado sozinho na primeira vez que a API sobe (se ainda nao existir).
# Em producao a senha vem do Infisical. Minimo 12 caracteres. Se preencher um, preencha os dois.
# Tire o # das duas linhas abaixo para ativar:
# ADMIN_SEED_EMAIL=admin@hemovida.com
# ADMIN_SEED_PASSWORD=troque-por-uma-senha-forte

# Integracao com o MS1 Doadores (passo 5).
# SERVICE_KEY: segredo compartilhado MS1<->MS4, minimo 32 caracteres (o MESMO valor nos dois). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# MS1_BASE_URL: endereco do MS1 (a porta combine com a Bia).
# SERVICE_KEY=
# MS1_BASE_URL=http://localhost:7501

# Quando houver gateway na frente: 1. Sem gateway: deixe 0 (ou apague a linha).
# TRUST_PROXY=0
